# Copy to .env.local for local development. On Cloudflare, set these with
#   npx wrangler secret put RESEND_API_KEY   (and the same for the others)

# Resend API key (https://resend.com/api-keys). Without it, form submissions are only
# printed to the dev server console locally, and fail in production.
RESEND_API_KEY=

# Sender for form emails. Must be on a domain verified in Resend, e.g.:
EMAIL_FROM="One World Limousine <forms@eapremiumtransportation.com>"

# Inbox that receives contact messages and driver applications (defaults to info@eapremiumtransportation.com).
# EMAIL_TO=info@eapremiumtransportation.com
